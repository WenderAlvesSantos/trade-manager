# Vercel Postgres (Neon) — copie de Vercel > Storage > seu banco > .env.local
# Conexão com pooler (usada pela aplicação em runtime)
DATABASE_URL="postgres://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Conexão direta (usada pelo Prisma Migrate)
DATABASE_URL_UNPOOLED="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""

# Web Push (VAPID) — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@exemplo.com"

# Integração com o site da Megan (cria a conta no cadastro do teste).
# Mesmo valor de TRADE_MANAGER_API_KEY no megan-site — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEGAN_INTEGRATION_KEY=""

# Licença: o acesso exige licença da Megan vigente (mesma regra do bot), consultada em MEGAN_SITE_URL/api/acesso.
MEGAN_SITE_URL="https://megan-n18.origem.tech"
# Página de compra mostrada no login e na tela de licença vencida (opcional).
MEGAN_COMPRA_URL=""
# Só em desenvolvimento: "off" libera o acesso sem consultar o site (ignorado em produção).
MEGAN_LICENSE_CHECK=""
