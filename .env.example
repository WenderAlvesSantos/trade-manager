# Vercel Postgres (Neon) — copie de Vercel > Storage > seu banco > .env.local
# Conexão com pooler (usada pela aplicação em runtime)
DATABASE_URL="postgres://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Conexão direta (usada pelo Prisma Migrate)
DATABASE_URL_UNPOOLED="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""

# Web Push (VAPID) — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@exemplo.com"
